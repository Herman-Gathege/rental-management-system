# backend/example.env
#
# Backend environment template. The real values live in the repository root
# .env (Docker Compose loads that one); this file documents the variables the
# FastAPI app reads directly.

# ─── Core ───
DATABASE_URL=postgresql://rental_user:rental_pass@postgres:5432/rental_db
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ─── PII encryption (required) ───
PII_ENCRYPTION_KEY=
PII_BLIND_INDEX_KEY=

# ─── WhatsApp (primary communication channel) ───
WHATSAPP_ENV=sandbox
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_USE_TEMPLATES=false
WHATSAPP_DEFAULT_COUNTRY_CODE=254
WHATSAPP_DEFAULT_ORG_ID=

# ─── Email / SMTP (optional second channel) ───
#
# Set SMTP_HOST to enable the email channel at the platform level. Each
# organisation then chooses whether to use it in
# Settings → Communication Channels (WhatsApp only, fallback, both, or email
# only). Credentials are never stored in the database or returned by the API.
#
# With SMTP_HOST blank, email falls back to the legacy SendGrid transport when
# SENDGRID_API_KEY is present.
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@alphaone.africa
SMTP_FROM_NAME=AlphaOne
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# ─── Legacy email transport ───
SENDGRID_API_KEY=
EMAIL_FROM=noreply@alphaone.africa

# ─── Object storage (tenant documents, expense receipts) ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
